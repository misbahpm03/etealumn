# ---------------------------------------------------------------------------
# etealumn — environment configuration
# Copy this file to `.env.local` for local development. Never commit secrets.
# ---------------------------------------------------------------------------

# Public Supabase configuration (safe to expose in the browser via NEXT_PUBLIC_*).
# Required from Phase 3 (auth) onwards. The app boots without them in Phase 1/2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets must NEVER use the NEXT_PUBLIC_ prefix.
# An isolated server-only config exists at src/infrastructure/supabase/admin.ts
# (unused until Phase 3+). Uncomment and set when administrative operations land.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical site URL used for metadata/links. Defaults to localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
