# ---------------------------------------------------------------------------
# etealumn — environment configuration
# Copy this file to `.env.local` for local development. Never commit secrets.
# ---------------------------------------------------------------------------

# Public Supabase configuration (safe to expose in the browser via NEXT_PUBLIC_*).
# Required from Phase 3 (auth) onwards. The app boots without them in Phase 1/2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets must NEVER use the NEXT_PUBLIC_ prefix.
# Used since Phase 6 for system writes ordinary users must not perform
# (login bookkeeping) and future administrative operations. Uncomment and set
# when running against a real project.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL used for metadata/links AND auth email redirects
# (password reset, verification). The host must be allow-listed in the
# Supabase dashboard (Authentication → URL Configuration), otherwise emailed
# links refuse to land on the app. Defaults to localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
